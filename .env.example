# OpenAI API key used by LangChain LLMs or chat models.
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Polymarket CLOB configuration derived from https://github.com/polymarket/py-clob-client
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_PRIVATE_KEY=0xabc123
POLYMARKET_FUNDER=0xabc123  # optional for EOAs; required for Magic/funder setups

# Gamma Markets API base URL for listing markets/events.
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com

# Enable verbose logging when set to true/1.
POLYMARKET_DEBUG=false

# Flask chatbot server options.
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
FLASK_DEBUG=false
CHATBOT_INCLUDE_TRACE=false

# Telegram bot bridge.
TELEGRAM_BOT_TOKEN=123456789:example-token
TELEGRAM_ALLOWED_USER_IDS=11111111,22222222
